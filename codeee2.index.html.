
<!DOCTYPE html>
<html>
<head>
    <title>IT Help Desk System</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f6fa;
            color: #183153;
            margin: 0;
        }

        header {
            background: #0879cf;
            height: 70px;
            border-bottom: 4px solid #1597e5;
            display: flex;
            align-items: center;
            padding: 0 20px;
            position: relative;
        }

        header img {
            width: 210px;
            height: 55px;
            object-fit: contain;
        }

        header h1 {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 24px;
            margin: 0;
        }

        header h1 span {
            color: #38bdf8;
        }

        .container {
            padding: 20px;
        }

        button {
            padding: 10px 14px;
            cursor: pointer;
            background: white;
            border: 1px solid #8b9bb0;
            color: #183153;
        }

        button:hover {
            background: #eaf3ff;
        }

        .submit {
            background: #1688df;
            color: white;
            border: none;
        }

        .table-box {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th {
            background: #e7edf5;
            text-align: left;
        }

        th, td {
            padding: 12px;
            border: 1px solid #cbd4df;
        }

        .category-name {
            font-weight: bold;
            display: block;
            margin-bottom: 8px;
        }

        .issue-name {
            color: #526b8a;
        }

        .tag {
            display: inline-block;
            padding: 6px 10px;
        }

        .Low, .Resolved {
            background: #bfe9d3;
            color: #12683d;
        }

        .Medium {
            background: #f6d0b6;
            color: #9b4b18;
        }

        .High {
            background: #f5c4c4;
            color: #a32121;
        }

        .In-Progress {
            background: #1688df;
            color: white;
        }

        .edit {
            color: #0879cf;
        }

        .delete {
            color: #b42323;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0006;
            overflow-y: auto;
            z-index: 5;
        }

        .form-box {
            background: white;
            border: 3px solid #1597e5;
            max-width: 650px;
            margin: 30px auto;
            padding: 20px;
        }

        .choices {
            display: flex;
            gap: 10px;
            margin: 15px 0 20px;
            flex-wrap: wrap;
        }

        .choice {
            flex: 1;
            min-width: 100px;
        }

        .selected {
            background: #0879cf;
            color: white;
        }

        .input-row {
            display: flex;
            gap: 15px;
            margin: 15px 0;
        }

        .input-group {
            flex: 1;
            min-width: 0;
        }

        input, textarea {
            width: 100%;
            padding: 10px;
            margin-top: 8px;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            border: 1px solid #aab6c5;
        }

        textarea {
            height: 90px;
        }

        .actions {
            text-align: right;
            margin-top: 20px;
        }

        .summary-row {
            padding: 10px 0;
            border-bottom: 1px solid #ddd;
            overflow-wrap: anywhere;
        }

        .summary-row strong {
            display: inline-block;
            width: 155px;
        }

        @media (max-width: 600px) {
            header {
                padding: 0 8px;
            }

            header img {
                width: 125px;
            }

            header h1 {
                font-size: 17px;
                left: auto;
                right: 10px;
                transform: none;
            }

            .container {
                padding: 12px;
            }

            .input-row {
                flex-direction: column;
            }

            .form-box {
                margin: 12px;
                padding: 15px;
            }

            table {
                min-width: 800px;
            }
        }
    </style>
</head>

<body>

<header>
    <img src="001.png" alt="Pasig Catholic College Banner">
    <h1><span>IT</span> Help Desk</h1>
</header>

<div class="container">

    <button class="submit" onclick="openForm()">
        + Submit Report
    </button>

    <br><br>

    <div class="table-box">
        <table>
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Floor</th>
                    <th>Assigned Technician</th>
                    <th>Issue</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="ticketTable"></tbody>
        </table>
    </div>

</div>

<div class="modal" id="reportModal">
    <div class="form-box">

        <h2 id="formTitle">Submit Technical Problem Report</h2>

        <p>Problem Category</p>

        <div class="choices" id="categoryChoices">
            <button class="choice"
                onclick="chooseCategory('Hardware', this)">
                Hardware
            </button>

            <button class="choice"
                onclick="chooseCategory('Software', this)">
                Software
            </button>

            <button class="choice"
                onclick="chooseCategory('Other Technical Problem', this)">
                Other Technical Problem
            </button>
        </div>

        <p>Location Information</p>

        <div class="input-row">
            <div class="input-group">
                <label for="room">Room</label>
                <input id="room" placeholder="e.g. 104">
            </div>

            <div class="input-group">
                <label for="floor">Floor</label>
                <input id="floor" placeholder="e.g. 4th floor">
            </div>
        </div>

        <p>Priority Level</p>

        <div class="choices" id="priorityChoices">
            <button class="choice"
                onclick="choosePriority('Low', this)">Low</button>

            <button class="choice"
                onclick="choosePriority('Medium', this)">Medium</button>

            <button class="choice"
                onclick="choosePriority('High', this)">High</button>
        </div>

        <p>Problem Details</p>

        <textarea id="details"
            placeholder="Describe the problem..."></textarea>

        <p id="error" style="color:red;"></p>

        <div class="actions">
            <button onclick="cancelForm()">Cancel</button>
            <button class="submit" id="saveButton"
                onclick="saveTicket()">Submit</button>
        </div>

    </div>
</div>

<div class="modal" id="summaryModal">
    <div class="form-box">

        <h2>Summary Report</h2>
        <p>Your technical problem report has been submitted.</p>

        <div class="summary-row">
            <strong>Category:</strong>
            <span id="sumCategory"></span>
        </div>

        <div class="summary-row">
            <strong>Room:</strong>
            <span id="sumRoom"></span>
        </div>

        <div class="summary-row">
            <strong>Floor:</strong>
            <span id="sumFloor"></span>
        </div>

        <div class="summary-row">
            <strong>Priority:</strong>
            <span id="sumPriority"></span>
        </div>

        <div class="summary-row">
            <strong>Problem Details:</strong>
            <span id="sumDetails"></span>
        </div>

        <div class="summary-row">
            <strong>Assigned Technician:</strong>
            <span id="sumTechnician"></span>
        </div>

        <div class="summary-row">
            <strong>Status:</strong>
            <span id="sumStatus"></span>
        </div>

        <div class="actions">
            <button class="submit" onclick="closeSummary()">Done</button>
        </div>

    </div>
</div>

<script>
var tickets = [
    {
        id: 1,
        room: "165",
        floor: "4th floor",
        technician: "Alexa River",
        category: "Hardware",
        issue: "No internet connection",
        priority: "Medium",
        status: "In Progress",
        owner: "sample"
    },
    {
        id: 2,
        room: "481",
        floor: "4th floor",
        technician: "Marcos",
        category: "Hardware",
        issue: "Computer won't turn on",
        priority: "Medium",
        status: "In Progress",
        owner: "sample"
    },
    {
        id: 3,
        room: "59",
        floor: "2nd floor",
        technician: "Pagaran",
        category: "Software",
        issue: "Cannot log in",
        priority: "Low",
        status: "Resolved",
        owner: "sample"
    },
    {
        id: 4,
        room: "56",
        floor: "2nd floor",
        technician: "Marcos",
        category: "Hardware",
        issue: "Computer has no sound",
        priority: "Low",
        status: "Resolved",
        owner: "sample"
    }
];

var technicians = [
    "Alexa River",
    "Marcos",
    "Pagaran",
    "Jamie Cruz"
];

var category = "";
var priority = "";
var editIndex = -1;
var nextId = 5;

function openForm() {
    clearForm();
    editIndex = -1;

    document.getElementById("formTitle").textContent =
        "Submit Technical Problem Report";

    document.getElementById("saveButton").textContent = "Submit";
    document.getElementById("reportModal").style.display = "block";
}

function chooseCategory(value, button) {
    category = value;
    selectButton("categoryChoices", button);
}

function choosePriority(value, button) {
    priority = value;
    selectButton("priorityChoices", button);
}

function selectButton(groupId, selectedButton) {
    var buttons = document.querySelectorAll("#" + groupId + " button");

    for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove("selected");
    }

    selectedButton.classList.add("selected");
}

function clearForm() {
    document.getElementById("room").value = "";
    document.getElementById("floor").value = "";
    document.getElementById("details").value = "";
    document.getElementById("error").textContent = "";

    category = "";
    priority = "";

    var buttons = document.querySelectorAll(".choice");

    for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove("selected");
    }
}

function cancelForm() {
    if (confirm("Are you sure you want to cancel?")) {
        document.getElementById("reportModal").style.display = "none";
        clearForm();
        editIndex = -1;
    }
}

function saveTicket() {
    var room = document.getElementById("room").value.trim();
    var floor = document.getElementById("floor").value.trim();
    var details = document.getElementById("details").value.trim();

    if (room == "" || floor == "" || details == "" ||
        category == "" || priority == "") {

        document.getElementById("error").textContent =
            "Please complete all fields.";
        return;
    }

    if (editIndex == -1) {
        var randomNumber = Math.floor(
            Math.random() * technicians.length
        );

        var newTicket = {
            id: nextId,
            room: room,
            floor: floor,
            technician: technicians[randomNumber],
            category: category,
            issue: details,
            priority: priority,
            status: "In Progress",
            owner: "user"
        };

        tickets.push(newTicket);
        nextId++;

        document.getElementById("reportModal").style.display = "none";
        clearForm();
        displayTickets();
        showSummary(newTicket);

    } else {
        tickets[editIndex].room = room;
        tickets[editIndex].floor = floor;
        tickets[editIndex].category = category;
        tickets[editIndex].issue = details;
        tickets[editIndex].priority = priority;

        document.getElementById("reportModal").style.display = "none";
        clearForm();
        editIndex = -1;
        displayTickets();

        alert("Report updated successfully.");
    }
}

function displayTickets() {
    var table = "";

    for (var i = 0; i < tickets.length; i++) {
        var ticket = tickets[i];
        var statusClass = ticket.status.replace(" ", "-");

        table += "<tr>";
        table += "<td>" + safeText(ticket.room) + "</td>";
        table += "<td>" + safeText(ticket.floor) + "</td>";
        table += "<td>" + safeText(ticket.technician) + "</td>";

        table += "<td>";
        table += "<span class='category-name'>" +
            safeText(ticket.category) + "</span>";
        table += "<span class='issue-name'>" +
            safeText(ticket.issue) + "</span>";
        table += "</td>";

        table += "<td><span class='tag " + ticket.priority + "'>" +
            safeText(ticket.priority) + "</span></td>";

        table += "<td><span class='tag " + statusClass + "'>" +
            safeText(ticket.status) + "</span></td>";

        table += "<td>";

        if (ticket.owner == "user") {
            table += "<button class='edit' onclick='editTicket(" +
                i + ")'>Edit</button> ";

            table += "<button class='delete' onclick='deleteTicket(" +
                i + ")'>Delete</button>";
        } else {
            table += "—";
        }

        table += "</td></tr>";
    }

    document.getElementById("ticketTable").innerHTML = table;
}

function editTicket(index) {
    if (tickets[index].owner != "user") {
        alert("You can only edit your own reports.");
        return;
    }

    if (confirm("Are you sure you want to edit this report?")) {
        editIndex = index;
        var ticket = tickets[index];

        clearForm();

        document.getElementById("room").value = ticket.room;
        document.getElementById("floor").value = ticket.floor;
        document.getElementById("details").value = ticket.issue;

        category = ticket.category;
        priority = ticket.priority;

        var categoryButtons = document.querySelectorAll(
            "#categoryChoices button"
        );

        for (var i = 0; i < categoryButtons.length; i++) {
            if (categoryButtons[i].textContent.trim() == category) {
                categoryButtons[i].classList.add("selected");
            }
        }

        var priorityButtons = document.querySelectorAll(
            "#priorityChoices button"
        );

        for (var j = 0; j < priorityButtons.length; j++) {
            if (priorityButtons[j].textContent.trim() == priority) {
                priorityButtons[j].classList.add("selected");
            }
        }

        document.getElementById("formTitle").textContent =
            "Edit Technical Problem Report";

        document.getElementById("saveButton").textContent =
            "Save Changes";

        document.getElementById("reportModal").style.display = "block";
    }
}

function deleteTicket(index) {
    if (tickets[index].owner != "user") {
        alert("You can only delete your own reports.");
        return;
    }

    if (confirm("Are you sure you want to delete this report?")) {
        tickets.splice(index, 1);
        displayTickets();
        alert("Report deleted successfully.");
    }
}

function showSummary(ticket) {
    document.getElementById("sumCategory").textContent = ticket.category;
    document.getElementById("sumRoom").textContent = ticket.room;
    document.getElementById("sumFloor").textContent = ticket.floor;
    document.getElementById("sumPriority").textContent = ticket.priority;
    document.getElementById("sumDetails").textContent = ticket.issue;
    document.getElementById("sumTechnician").textContent = ticket.technician;
    document.getElementById("sumStatus").textContent = ticket.status;

    document.getElementById("summaryModal").style.display = "block";
}

function closeSummary() {
    document.getElementById("summaryModal").style.display = "none";
    alert("Report submitted successfully!");
}

function safeText(value) {
    var symbols = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    };

    return String(value).replace(/[&<>"']/g, function(character) {
        return symbols[character];
    });
}

displayTickets();
</script>

</body>
</html>
